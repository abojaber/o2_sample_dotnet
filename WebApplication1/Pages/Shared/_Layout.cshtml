@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var rumEnabled = Configuration.GetValue<bool>("OpenObserve:Rum:Enabled");
    var rumAppId = Configuration["OpenObserve:Rum:ApplicationId"];
    var rumClientToken = Configuration["OpenObserve:Rum:ClientToken"];
    var rumSite = Configuration["OpenObserve:Rum:Site"];
    var rumOrgIdentifier = Configuration["OpenObserve:Organization"];
    var rumService = Configuration["OpenObserve:Rum:Service"];
    var rumVersion = Configuration["OpenObserve:Rum:Version"];
    var rumSampleRate = Configuration.GetValue<int>("OpenObserve:Rum:SessionSampleRate");
    var rumReplaySampleRate = Configuration.GetValue<int>("OpenObserve:Rum:SessionReplaySampleRate");
    var rumTrackResources = Configuration.GetValue<bool>("OpenObserve:Rum:TrackResources");
    var rumTrackLongTasks = Configuration.GetValue<bool>("OpenObserve:Rum:TrackLongTasks");
    var rumTrackUserInteractions = Configuration.GetValue<bool>("OpenObserve:Rum:TrackUserInteractions");
    var rumInsecureHttp = Configuration.GetValue<bool>("OpenObserve:Rum:InsecureHTTP");
    var rumEnv = System.Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
    @if (rumEnabled)
    {
        <script src="~/js/openobserve-rum.js" asp-append-version="true"></script>
    }
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">WebApplication1</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/CallApi1">CallApi1</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/CallApi2">CallApi2</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/CallApi1AndThenApi2">CallApi1AndThenApi2</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/CallApi1ThrowEx">CallApi1ThrowEx</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2023 - WebApplication1 - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (rumEnabled)
    {
        <script>
            openobserveRum.init({
                applicationId: '@rumAppId',
                clientToken: '@rumClientToken',
                site: '@rumSite',
                organizationIdentifier: '@rumOrgIdentifier',
                service: '@rumService',
                env: '@rumEnv',
                version: '@rumVersion',
                sessionSampleRate: @rumSampleRate,
                sessionReplaySampleRate: @rumReplaySampleRate,
                trackResources: @rumTrackResources.ToString().ToLower(),
                trackLongTasks: @rumTrackLongTasks.ToString().ToLower(),
                trackUserInteractions: @rumTrackUserInteractions.ToString().ToLower(),
                apiVersion: 'v1',
                insecureHTTP: @rumInsecureHttp.ToString().ToLower(),
                defaultPrivacyLevel: 'allow'
            });

            openobserveLogs.init({
                clientToken: '@rumClientToken',
                site: '@rumSite',
                organizationIdentifier: '@rumOrgIdentifier',
                service: '@rumService',
                env: '@rumEnv',
                version: '@rumVersion',
                forwardErrorsToLogs: true,
                insecureHTTP: @rumInsecureHttp.ToString().ToLower(),
                apiVersion: 'v1'
            });

            openobserveRum.setUser({
                id: '1',
                name: 'Captain Hook',
                email: 'captainhook@example.com'
            });

            openobserveRum.startSessionReplayRecording();

            // Log page view to OpenObserve logs
            openobserveLogs.logger.info('Page viewed', {
                page: {
                    path: window.location.pathname,
                    title: document.title,
                    referrer: document.referrer || 'direct',
                    url: window.location.href
                }
            });

            // Track page view as a RUM action
            openobserveRum.addAction('page-view', {
                page: window.location.pathname,
                title: document.title
            });

            // Log resource loading errors (404s on images, scripts, etc.)
            window.addEventListener('error', function (event) {
                if (event.target !== window) {
                    var target = event.target;
                    var url = target.src || target.href || '';
                    openobserveLogs.logger.error('Resource load failed', {
                        resource: {
                            type: target.tagName ? target.tagName.toLowerCase() : 'unknown',
                            url: url
                        }
                    });
                }
            }, true);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>